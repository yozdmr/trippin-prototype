rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isTripOwner(tripData) {
      return request.auth.uid == tripData.userId;
    }

    function hasTripAccess(tripData) {
      return isTripOwner(tripData) || request.auth.uid in tripData.shared;
    }

    // Returns the role string for the current user on a trip.
    // Owner → 'owner', shared users → their role from the roles map (default 'viewer').
    function getUserRole(tripData) {
      return isTripOwner(tripData)
        ? 'owner'
        : (request.auth.uid in tripData.roles
            ? tripData.roles[request.auth.uid]
            : 'viewer');
    }

    function canEdit(tripData) {
      let role = getUserRole(tripData);
      return role == 'owner' || role == 'admin' || role == 'editor';
    }

    function canDelete(tripData) {
      let role = getUserRole(tripData);
      return role == 'owner' || role == 'admin';
    }

    // Users — any authenticated user can read (needed for email lookup),
    // but only the account owner can write their own document.
    match /users/{userId} {
      allow read:  if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      // Owner or anyone in shared[] can read.
      allow read: if isAuthed() && hasTripAccess(resource.data);

      // Authenticated user can create a trip they own.
      allow create: if isAuthed() && request.auth.uid == request.resource.data.userId;

      // Trip update rules by role:
      //  owner/admin – can update any field
      //  editor      – can update fields except shared[], roles, userId
      //  viewer      – can only add to shared[] (invite) and set roles for new users
      allow update: if isAuthed() && hasTripAccess(resource.data) && (
        canDelete(resource.data)
        ||
        (
          canEdit(resource.data) &&
          request.resource.data.userId == resource.data.userId
        )
        ||
        (
          // Viewers can invite: shared[] may grow and roles may gain new keys,
          // but userId must stay the same and no other fields may change.
          getUserRole(resource.data) == 'viewer' &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.budget == resource.data.budget &&
          request.resource.data.bannerImageUrl == resource.data.bannerImageUrl
        )
      );

      // Only the owner or admins can delete a trip.
      allow delete: if isAuthed() && canDelete(resource.data);

      // Days subcollection — read for anyone with access, write for editors+.
      match /days/{dayId} {
        allow read: if isAuthed() &&
          hasTripAccess(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if isAuthed() &&
          canEdit(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }

      // Events nested under days — read for anyone with access, write for editors+.
      match /days/{dayId}/events/{eventId} {
        allow read: if isAuthed() &&
          hasTripAccess(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow create, update: if isAuthed() &&
          canEdit(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow delete: if isAuthed() &&
          canDelete(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }

    // Wildcard rule required for collectionGroup("events") queries.
    match /{path=**}/events/{eventId} {
      allow read, write: if isAuthed();
    }
  }
}
